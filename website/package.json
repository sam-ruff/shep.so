{
  "name": "shep-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "build:demo": "npm --prefix ../web ci && npm --prefix ../web run build:preview",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs",
    "test": "npm run build && playwright test --project=chromium",
    "test:deployment": "node --test scripts/deployment.test.mjs",
    "test:all-browsers": "npm run build && playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0"
  }
}
