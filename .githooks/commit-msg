#!/usr/bin/env python3
import re
import sys
from pathlib import Path

subject = Path(sys.argv[1]).read_text().splitlines()[0]
if not re.match(r"^(feat|fix|perf|refactor|test|docs|style|build|ci|chore|revert)(\([a-z0-9_/-]+\))?!?: .+", subject):
    sys.exit("Use a Conventional Commit, e.g. feat(mail): add folder movement")
