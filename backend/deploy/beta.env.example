# Copy to /etc/shep/beta.env with root-only permissions. Do not commit the real file.
SHEP_PUBLIC_ORIGIN=https://shep.so
SHEP_BIND=127.0.0.1:3080
SHEP_WEB_DIR=/srv/shep/web
# Google Cloud OAuth client type: Web application.
# Authorized redirect URI: https://shep.so/auth/callback
SHEP_GOOGLE_CLIENT_ID=REPLACE_WITH_WEB_OAUTH_CLIENT_ID
SHEP_GOOGLE_CLIENT_SECRET=REPLACE_FROM_SECRET_CONFIGURATION
# Empty deliberately: nobody can log in until the exact owner identity is supplied.
SHEP_BETA_EMAILS=
SHEP_MAIL_ENDPOINTS=[]
# Administrator-only IP pins: web requests cannot choose arbitrary destinations.
# Example (replace both host and address after reviewing the mail VPS):
# SHEP_MAIL_ENDPOINTS=[{"host":"mail.example.test","port":993,"service":"imap","address":"127.0.0.1:993"},{"host":"mail.example.test","port":465,"service":"smtp","address":"127.0.0.1:465"}]
# Optional additional restriction to exact Google subject IDs, comma-separated.
SHEP_BETA_SUBJECTS=
